# Node does not automatically read this file. Copy to .env and run:
# node --env-file=.env src/main.mjs
BRIDGE_PORT=3789
BRIDGE_HOST=127.0.0.1
# Optional browser-facing URL (LAN / reverse proxy), also used for the OAuth callback:
# BRIDGE_PUBLIC_URL=http://192.168.1.10:3789
# Optional custom HTTP(S) MCP service that YOU trust:
# FISH_MCP_ENDPOINT=http://192.168.1.10:9000/mcp
# FISH_OAUTH_REDIRECT_URI=http://192.168.1.10:3789/oauth/callback
# FISH_OAUTH_CLIENT_ID=
# FISH_OAUTH_SCOPE=
# FISH_MCP_DATA_DIR=/your/private/state/directory
# Removed: BRIDGE_ALLOWED_ORIGINS and BRIDGE_ALLOWED_HOSTS are no longer checked.
